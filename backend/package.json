{
  "name": "app-medicos-backend",
  "version": "0.1.0",
  "description": "Prototipo (Fase 2) - API REST com autenticacao, criar e listar plantoes",
  "main": "dist/index.js",
  "scripts": {
    "dev": "set NODE_OPTIONS=--openssl-legacy-provider&& ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrar": "ts-node --transpile-only scripts/migrar.ts",
    "cadastrar-certificado": "set NODE_OPTIONS=--openssl-legacy-provider&& ts-node --transpile-only scripts/cadastrar-certificado.ts",
    "importar-hospitais": "set NODE_OPTIONS=--openssl-legacy-provider&& ts-node --transpile-only scripts/importar-hospitais.ts",
    "criar-medico": "ts-node --transpile-only scripts/criar-medico.ts",
    "cadastrar-empresa": "ts-node --transpile-only scripts/cadastrar-empresa.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "pg": "^8.12.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
